# OpenRouter API key — required
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default LLM model used for SQL generation when "model" is not
# specified in the /query request. Must be a valid OpenRouter model slug.
DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# Path to the SQLite database, relative to backend/
DATABASE_PATH=data/dataspeak.db